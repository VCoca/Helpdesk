{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Jwt:Key is deliberately absent. It is a secret and comes from user secrets
  // in development or an environment variable in Docker.
  "Jwt": {
    "Issuer": "Helpdesk.Api",
    "Audience": "Helpdesk.Client",
    "ExpiryMinutes": 60
  }
}
