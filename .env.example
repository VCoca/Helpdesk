# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is in .gitignore and must NEVER be committed.
# This file (.env.example) IS committed, with placeholders only.

# PostgreSQL
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# Backend
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=helpdesk;Username=helpdesk;Password=change_me_locally

# JWT signing key
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET
Jwt__Issuer=helpdesk-api
Jwt__Audience=helpdesk-client
Jwt__ExpiryMinutes=60

# Frontend
VITE_API_BASE_URL=http://localhost:5000
