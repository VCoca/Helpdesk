# Copy to .env.local and adjust if your ports differ.
#
# Must match an applicationUrl in src/Helpdesk.Api/Properties/launchSettings.json:
#   http  profile -> http://localhost:5053
#   https profile -> https://localhost:7097  (also listens on 5053)
#
# Use http in development and run the API with --launch-profile http.
# On the https profile, UseHttpsRedirection sends 5053 -> 7097, and browsers
# do not follow redirects on CORS preflight requests, so calls from the client
# fail in a way that looks like a CORS error.
VITE_API_BASE_URL=http://localhost:5053
